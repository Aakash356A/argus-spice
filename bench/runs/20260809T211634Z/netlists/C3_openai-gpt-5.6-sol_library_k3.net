LT8710 24V-to-12V synchronous SEPIC converter

.lib LT8710.sub

VINPUT IN 0 24
RIN IN VIN 20m
CIN VIN 0 47u Rser=30m

L1 VIN SW1 15u Rser=20m
CSEP SW1 SW2 10u Rser=20m
L2 0 SW2 15u Rser=20m

MMAIN SW1 GMAIN CSP CSP NCH
RSENSE CSP 0 15m
RBG BG GMAIN 4.7

MSYNC OUT GSYNC SW2 SW2 NCH
RTG TG GSYNC 4.7

COUT OUT 0 470u Rser=25m
RLOAD OUT 0 12

RBST BST SW2 1Meg
CBST BST SW2 100n

REN1 VIN ENFB 180k
REN2 ENFB 0 18k

RFB1 OUT FBX 88.7k
RFB2 FBX 0 10k

RRT RT 0 100k
CSS SS 0 22n
RVC VC VCOMP 10k
CVC VCOMP 0 10n
CVC2 VC 0 100p

CINTVCC INTVCC 0 4.7u Rser=30m
RMODE MODE INTVCC 10
RSYNC SYNC 0 10
RBIAS OUT BIAS 1

XU1 VIN ENFB SYNC RT SS VC FBX MODE 0 CSP 0 BG INTVCC BIAS TG SW2 BST LT8710

.model NCH VDMOS(Vto=2.2 Kp=80 Rg=2 Rd=4m Rs=3m
+ Cgdmax=1n Cgdmin=50p Cgs=2n Cjo=1n Is=1n)

.options plotwinsize=0 reltol=0.003
.tran 0 20m 0 100n startup
.meas tran vout_dc AVG V(OUT) FROM=18m TO=20m

.end
