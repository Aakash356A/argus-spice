* ADG5248F 8:1 analog multiplexer, channel 1 selected
.lib ADG.lib

VDD VDD 0 15
VSS VSS 0 -15

VIN IN 0 SINE(0 500m 1k)

VA0 A0 0 0
VA1 A1 0 0
VA2 A2 0 0
VEN EN 0 5

VCH2 CH2 0 0
VCH3 CH3 0 0
VCH4 CH4 0 0
VCH5 CH5 0 0
VCH6 CH6 0 0
VCH7 CH7 0 0
VCH8 CH8 0 0

XU1 OUT IN CH2 CH3 CH4 CH5 CH6 CH7 CH8 A0 A1 A2 EN FF VDD VSS 0 ADG5248F

RLOAD OUT 0 1Meg

.tran 0 10m 5m 2u
.meas tran VIN_RMS RMS V(IN) FROM=5m TO=10m
.meas tran VOUT_RMS RMS V(OUT) FROM=5m TO=10m
.meas tran GAIN_DB PARAM 20*log10(VOUT_RMS/VIN_RMS)

.end
