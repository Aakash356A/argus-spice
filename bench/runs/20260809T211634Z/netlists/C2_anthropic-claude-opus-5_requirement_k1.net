* ADG5248F 8:1 Fault-Protected Analog Multiplexer
* Channel 1 (S1) selected, 1 kHz / 500 mV sine passed to common D output
* -----------------------------------------------------------------------

* --- Genuine ADI device model (do not redefine) ---
.include ADG5248F.cir

* --- Supplies ---
VDD  VDD  0  DC  15
VSS  VSS  0  DC -15
VLOG VL   0  DC  5

* --- Digital control: A2 A1 A0 = 000 -> channel 1 ; EN = high ---
VA0  A0   0  DC 0
VA1  A1   0  DC 0
VA2  A2   0  DC 0
VEN  EN   0  DC 5

* --- Signal source: 1 kHz, 500 mV amplitude sine ---
VIN  IN   0  SINE(0 0.5 1k)

* --- Unused source channels tied to ground ---
R2 S2 0 1k
R3 S3 0 1k
R4 S4 0 1k
R5 S5 0 1k
R6 S6 0 1k
R7 S7 0 1k
R8 S8 0 1k

* --- Multiplexer (datasheet pin order) ---
* S1 S2 S3 S4 VSS GND A0 A1 A2 EN VDD D S8 S7 S6 S5
XU1 IN S2 S3 S4 VSS 0 A0 A1 A2 EN VDD OUT S8 S7 S6 S5 ADG5248F

* --- High-impedance load on common output ---
RL  OUT 0 1MEG
CL  OUT 0 5p

* --- Analysis ---
.tran 0 5m 0 1u

.meas TRAN vin_pp  PP V(IN)  FROM=1m TO=5m
.meas TRAN vout_pp PP V(OUT) FROM=1m TO=5m
.meas TRAN gain_db PARAM 20*log10(vout_pp/vin_pp)

.options plotwinsize=0
.end
