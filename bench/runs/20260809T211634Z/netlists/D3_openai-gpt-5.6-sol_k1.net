VCC VCC 0 5
VIN IN 0 SINE(2.5 20m 1k) AC 20m
VINN INN 0 2.5

RREF1 VCC REF 100k
RREF2 REF 0 100k
CREF REF 0 1u

XU1 IN INN REF VCC 0 OUT AD8237 PARAMS: G=10
RLOAD OUT 0 100k
CLOAD OUT 0 20p

.tran 0 5m 0 2u
.ac dec 100 10 100k
.meas AC gain_db FIND 20*log10(mag(V(OUT)/V(IN))) AT=1k

.subckt AD8237 INP INN REF VPOS VNEG OUT PARAMS: G=10
RINP INP VNEG 10G
RINN INN VNEG 10G
EAMP OUT REF INP INN {G}
.ends AD8237

.end
