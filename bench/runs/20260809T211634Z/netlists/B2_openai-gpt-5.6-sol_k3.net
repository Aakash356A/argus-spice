* ADA4177 inverting amplifier, gain = -10 V/V
VCC VPLUS 0 15
VEE VMINUS 0 -15
VIN IN 0 SINE(0 50m 1k) AC 1

RIN IN NINV 10k
RFB OUT NINV 100k
XU1 0 NINV VPLUS VMINUS OUT ADA4177

.tran 0 10m 5m 1u
.ac dec 100 10 1Meg
.meas AC gain_db FIND VDB(OUT) AT=1k

* Self-contained ADA4177 functional macromodel
* Pins: noninverting inverting positive_supply negative_supply output
.subckt ADA4177 NONINV INV VP VN OUT
EOL NGAIN 0 NONINV INV 1e6
RDOM NGAIN NPOLE 1k
CDOM NPOLE 0 45.5n
EOUT OUT 0 VALUE={LIMIT(V(NPOLE),V(VN)+0.1,V(VP)-0.1)}
.ends ADA4177

.end
