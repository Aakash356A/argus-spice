* ADG5248F 8:1 Fault-Protected Analog Multiplexer
* Channel 1 (S1) selected -> D (OUT), +/-15 V supplies, 1 kHz 500 mV sine
*------------------------------------------------------------------
.lib ADG.lib

*--- Signal source -------------------------------------------------
VIN     IN  0   SINE(0 0.5 1k)
RS      IN  S1  1

*--- Supplies ------------------------------------------------------
VDD     VDD 0   DC  15
VSS     VSS 0   DC -15
VL      VL  0   DC   5

*--- Address / enable lines: A2 A1 A0 = 000, EN = high -> channel 1 -
VA0     A0  0   DC 0
VA1     A1  0   DC 0
VA2     A2  0   DC 0
VEN     EN  0   DC 5

*--- Fault-flag open-drain pull-up ---------------------------------
RFF     FF  VL  10k

*--- Unused (off) channel terminations -----------------------------
R2      S2  0   10k
R3      S3  0   10k
R4      S4  0   10k
R5      S5  0   10k
R6      S6  0   10k
R7      S7  0   10k
R8      S8  0   10k

*--- Multiplexer ---------------------------------------------------
XU1 S1 S2 S3 S4 S5 S6 S7 S8 OUT A0 A1 A2 EN VDD VSS 0 VL FF ADG5248F

*--- Output load ---------------------------------------------------
RL      OUT 0   100k
CL      OUT 0   5p

*--- Analysis ------------------------------------------------------
.tran 0 5m 0 1u

.meas TRAN vin_pp  PP V(IN)  FROM=1m TO=5m
.meas TRAN vout_pp PP V(OUT) FROM=1m TO=5m
.meas TRAN gain_db PARAM 20*log10(vout_pp/vin_pp)

.options plotwinsize=0 numdgt=7
.end
