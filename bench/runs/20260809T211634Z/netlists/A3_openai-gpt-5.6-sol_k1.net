LT3094 -5V Negative LDO Regulator
VINPUT IN 0 -7
CIN IN 0 10u

XU1 IN OUT SET 0 LT3094
RSET SET 0 49.9k
COUT OUT 0 10u
RLOAD OUT 0 10k

.tran 0 20m 0 10u
.meas tran VOUT_DC AVG V(OUT) FROM=15m TO=20m

.subckt LT3094 IN OUT SET GND
ISET SET GND 100u
IQ GND IN 2.3m
BREG NREG GND V={max(V(IN,GND)+0.30,V(SET,GND))}
ROUT NREG OUT 0.05
.ends LT3094

.end
