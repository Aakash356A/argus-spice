* AD8092 non-inverting amplifier, gain = 5 V/V
.include AD8092.cir

VCC VCC 0 5
VEE VEE 0 -5

VIN IN 0 SINE(0 100m 1Meg) AC 1

XU1 IN NFB VCC VEE OUT AD8092

RFB OUT NFB 4k
RG   NFB 0   1k
RLOAD OUT 0 1k

CPLUS  VCC 0 100n
CMINUS VEE 0 100n

.tran 0 10u 2u 2n
.ac dec 100 100k 100Meg
.meas AC gain_db FIND VDB(OUT) AT=1Meg

.end
