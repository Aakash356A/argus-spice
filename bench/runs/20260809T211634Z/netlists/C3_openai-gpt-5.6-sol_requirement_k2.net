* LT8710 synchronous SEPIC converter: 24 V input, 12 V output
.include LT8710.sub

VIN IN 0 PULSE(0 24 0 100u 100u 1 2)
CIN1 IN 0 100u
CIN2 IN 0 1u

* SEPIC power stage
L1 IN SW1 22u
CSEP SW1 SW 4.7u
L2 SW 0 22u

MLOW SW1 BG SENSE SENSE PWRNMOS
RCS SENSE 0 10m

MHIGH PREOUT TG SW SW PWRNMOS
ROCS PREOUT OUT 10m

COUT1 OUT 0 220u
COUT2 OUT 0 1u
RLOAD OUT 0 12

* LT8710 supply, enable, feedback, timing, and compensation
CINTVCC INTVCC 0 4.7u
RGATEVCC GATEVCC INTVCC 0.01
DBOOT GATEVCC BST DBOOT
CBST BST SW 100n

REN1 IN ENFB 220k
REN2 ENFB 0 15k

RFB1 OUT FBX 88.7k
RFB2 FBX 0 10k

RRT RT 0 100k
RSYNC SYNC 0 1
RBIAS BIAS OUT 0.01

RCOMP VC VCOMP 20k
CCOMP VCOMP 0 10n
CHF VC 0 100p

CIMON IMON 0 1n
CCLK CLKOUT 0 1p

* LT8710 pin order:
* SYNC RT CLKOUT EN/FBIN VIN INTVCC GATEVCC BG CSP CSN
* GND TG SW BST ISN ISP IMON VC FBX BIAS
XU1 SYNC RT CLKOUT ENFB IN INTVCC GATEVCC BG SENSE 0 0 TG SW BST OUT PREOUT IMON VC FBX BIAS LT8710

.model DBOOT D(Is=10n Rs=0.08 N=1.05 Cjo=40p Bv=40 Ibv=10u)
.model PWRNMOS VDMOS(Vto=2.5 Kp=80 Rg=2 Rd=8m Rs=5m Rb=5m Cgdmax=800p Cgdmin=80p Cgs=2n Cjo=1n Is=1n N=1.1 Bv=80 Ibv=10u)

.tran 0 20m 0 100n startup
.meas tran VOUT_DC AVG V(OUT) FROM=18m TO=20m

.options plotwinsize=0
.end
