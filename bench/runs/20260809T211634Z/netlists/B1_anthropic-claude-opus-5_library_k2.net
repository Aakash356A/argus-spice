* AD8092 Non-Inverting Amplifier, Gain = +5 V/V, +/-5 V Supplies
* Input: 100 mV amplitude sine at 1 MHz

.lib ADI.lib

*** Supplies ***
VCC VCC 0 DC  5
VEE VEE 0 DC -5

*** Input source: 100 mVpk sine @ 1 MHz (AC=1 for .ac sweep) ***
VIN IN 0 SINE(0 0.1 1MEG 0 0 0) AC 1

*** Amplifier: X<name> +IN -IN V+ V- OUT AD8092 ***
XU1 IN FB VCC VEE OUT AD8092

*** Feedback network: gain = 1 + Rf/Rg = 1 + 4k/1k = 5 ***
RF OUT FB 4k
RG FB  0  1k

*** Output load ***
RL OUT 0 1k

*** Analyses ***
.ac dec 100 10k 100MEG
.tran 0 5u 0 1n

*** Measurements ***
.meas AC gain_db FIND 20*log10(V(OUT)/V(IN)) AT 1MEG
.meas TRAN vout_pp PP V(OUT) FROM 2u TO 5u
.meas TRAN gain_db_tran PARAM 20*log10(vout_pp/0.2)

.options plotwinsize=0
.end
