* MAX44245 non-inverting amplifier, gain = 20 V/V
VCC VCC 0 15
VEE VEE 0 -15
VIN IN 0 SINE(0 50m 1k) AC 50m

RG NFB 0 1k
RF OUT NFB 19k

XU1 IN NFB VCC VEE OUT MAX44245

.tran 0 10m 5m 1u
.ac dec 100 10 100k
.meas AC gain_db FIND db(V(OUT)/V(IN)) AT=1k

.subckt MAX44245 INP INN VDD VSS OUT
RINP INP 0 1T
RINN INN 0 1T
GERR 0 NINT INP INN 1m
ROLA NINT 0 1G
CDOM NINT 0 15.915p
BOUT OUT 0 V=limit(V(NINT),V(VSS)+0.1,V(VDD)-0.1)
.ends MAX44245

.end
