* AD8092 non-inverting amplifier, gain = 5 V/V
VCC VPLUS 0 5
VEE VMINUS 0 -5
VIN IN 0 SINE(0 100m 1Meg) AC 100m

RG NINV 0 1k
RF OUT NINV 4k
XU1 IN NINV VPLUS VMINUS OUT AD8092

RLOAD OUT 0 1k

.ac dec 100 100k 100Meg
.tran 0 10u 2u 2n
.meas AC gain_db FIND 20*log10(mag(V(OUT)/V(IN))) AT=1Meg

.subckt AD8092 INP INN VP VN OUT
GERR NINT 0 INN INP 1
RDOM NINT 0 100k
CDOM NINT 0 1.447n
EBUF NDRV 0 NINT 0 1
ROUT NDRV OUT 5
RBIASP INP 0 100Meg
RBIASN INN 0 100Meg
.ends AD8092

.end
