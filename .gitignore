# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# --- Editors and operating systems -----------------------------------------
.vscode/
.idea/
.claude/
.conda/
.DS_Store
Thumbs.db

# --- LTspice and GUI output ------------------------------------------------
*.raw
*.log
*.plt
*_edited_*.cir
outputs/
outputs_archive/
tmp/
temp/

# --- Local models and training state ---------------------------------------
models/
training/

# --- Data ------------------------------------------------------------------
# Only the reference netlists that a case or a frozen held-out part uses are
# published (59 files, already tracked). Keep any larger local export of the
# LTspice examples next to them; add a new reference with `git add -f`.
data/templates/*
data/**/*.cir
data/generated/
data/candidate_inputs/
data/evidence/
data/verified_pairs.jsonl
*_candidate_arena.json

# Local IC shortlist used by the GUI's suggestion feature (see app/README.md).
app/available_ics.txt

# --- Benchmark -------------------------------------------------------------
# Published: every record the paper's numbers are computed from (completions,
# extracted decks, grades, and the mutant, fixture, collateral and same-name
# ledgers under bench/runs/).
#
# Not published: build output and per-run worksheets.
generated/
netlists_to_grade_*.md
bench/runs/tools-interactive/
bench/probe_tools.py
bench/multimetric.py
bench/runs/*/multimetric.jsonl
bench/runs/*/grading.csv
bench/runs/*/summary.csv

# The `strict` pilot arm is outside the paper's three-arm design. The published
# results.jsonl and config.json carry the 540 generations the paper reports;
# these unfiltered copies stay local.
bench/runs/*/results.with-strict.jsonl
bench/runs/*/config.with-strict.json
bench/runs/*/netlists/*_strict_k*
bench/runs/*/raw/*_strict_k*

# Point-in-time backups and history bundles.
*.bak-*
*.bundle
