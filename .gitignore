.DS_Store
Thumbs.db

# LTspice and GUI-generated artifacts
*.raw
*.op.raw
*.log
*.plt
*_edited_*.cir
outputs/
outputs_archive/
tmp/
temp/

# Generated datasets and local training state
training/datasets/
training/runs/
training/checkpoints/
training/unsloth_compiled_cache/
training/offload/

# Checkpoints and duplicated training-resume artifacts.
# The single published runtime adapter remains tracked through Git LFS.
models/**/checkpoint-*/
models/**/*.pt
models/**/*.pth
models/**/optimizer.*
models/**/scheduler.*
models/**/rng_state.*
models/**/trainer_state.*
models/**/training_args.*

# Keep curated source templates, but never commit generated non-.net data files.
data/**/*.raw
data/**/*.op.raw
data/**/*.log
data/**/*.cir
data/generated/

# Local Candidate Arena inputs and reproducible-but-run-specific evidence.
# The curated verified_pairs.jsonl remains versioned.
data/candidate_inputs/
data/evidence/
*_candidate_arena.json

# ---------------------------------------------------------------------------
# Kept locally, not published.
#
# This repository publishes the paper's artifact and the desktop GUI. The
# following are working material or superseded work: they remain in the
# working tree and are simply not tracked.
# ---------------------------------------------------------------------------

# Internal working notes and the superseded ACM draft of the paper.
HANDOFF.md
ACM_Journals_Primary_Article_Template/
requirements-training.txt
requirements-amd.txt

# Discarded fine-tuning line: the LoRA adapter, its training scripts, the
# serving notebooks, and the RL/data scaffolding that was never wired in.
models/
training/
netgen/
notebooks/

# Documentation for the earlier system, superseded by README.md.
docs/

# Local IC shortlist used by the GUI's suggestion feature (see app/README.md).
app/available_ics.txt

# The `strict` pilot arm is outside the paper's three-arm design. The published
# results.jsonl and config.json carry the 540 generations the paper reports;
# these unfiltered copies stay local.
bench/runs/*/results.with-strict.jsonl
bench/runs/*/config.with-strict.json
bench/runs/*/netlists/*_strict_k*
bench/runs/*/raw/*_strict_k*

